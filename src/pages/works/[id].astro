---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/PageLayout.astro'
import WorksImage from '@/components/works/WorksImage.astro'
import WorksAlso from '@/components/works/WorksAlso.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map(project => ({ params: { id: project.id } }))
}

const { id } = Astro.params
Astro.locals.project = id
const projects = await getCollection('projects')
const sorted = projects.toSorted((a, b) => a.data.order - b.data.order)
const project = sorted.find(p => p.id === id)!
const idx = sorted.findIndex(p => p.id === id)
const nextProjects = [
  sorted[(idx + 1) % sorted.length],
  sorted[(idx + 2) % sorted.length],
]

const { Content } = await render(project)
const { title, description, year } = project.data
---

<Layout title={`${title} — aoie`}>
  <div class="project-page">
    <div class="project-header">
      <hr class="project-divider page-wrap" />
      <div class="project-meta page-wrap section-grid">
        <span class="col-label text-body project-meta__title">{title}</span>
        <div class="col-content project-meta__right text-body">
          {description && <span class="project-meta__desc">{description}</span>}
          {year && <span class="project-meta__year">{year}</span>}
        </div>
      </div>
    </div>

    <main class="project-content page-wrap">
      <Content components={{ Single: WorksImage }} />
    </main>

    <WorksAlso projects={nextProjects} />
  </div>
</Layout>

<style>
  @import '../../styles/media.css';

  .project-page {
    display: flex;
    flex-direction: column;
  }

  .project-header {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2xl);
    height: var(--space-2xl);
  }

  .project-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 var(--page-pad) var(--2-lh);
  }

  .project-meta {
    align-items: baseline;
  }

  .project-meta__right {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--2-lh);
  }

  .project-meta__desc {
    max-width: calc(
      4 * (100vw - 2 * var(--page-pad) + var(--col-gap)) / var(--cols) -
        var(--col-gap)
    );
  }

  .project-content {
    padding-top: var(--4-lh);
    padding-bottom: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
  }

  @media (--mobile) {
    .project-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0;
    }

    .project-meta__title {
      flex: 1;
      order: 1;
    }

    .project-meta__right {
      display: contents;
    }

    .project-meta__year {
      order: 2;
    }

    .project-meta__desc {
      order: 3;
      width: 100%;
      margin-top: var(--2-lh);
    }
  }
</style>
