---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Layout from './Layout.astro'

interface Props {
  title: string
  hideFooter?: boolean
}

const { title, hideFooter = false } = Astro.props
---

<Layout title={title}>
  <div class="page">
    <SiteHeader />
    <slot />
    {!hideFooter && <SiteFooter />}
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }
</style>

<script>
  function bindHireButtons() {
    document.querySelectorAll<HTMLElement>('.hire-btn').forEach(btn => {
      if (btn.dataset.hireBound) {
        return
      }
      btn.dataset.hireBound = 'true'
      btn.addEventListener('click', e => {
        e.preventDefault()
        navigator.clipboard.writeText('hello@aoie.studio').catch(() => {
          /* ignore clipboard errors */
        })
        const original = btn.textContent
        btn.textContent = 'Copied'
        setTimeout(() => {
          btn.textContent = original
        }, 2000)
      })
    })
  }

  bindHireButtons()
  document.addEventListener('astro:page-load', bindHireButtons)
</script>
