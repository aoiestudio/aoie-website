<canvas class="approach-canvas" id="approach-canvas"></canvas>

<style>
  .approach-canvas {
    display: block;
    width: 100%;
    height: var(--size-canvas);
  }
</style>

<script>
  import { Renderer, Program, Mesh, Triangle } from 'ogl'
  import vert from './approach.vert?raw'
  import frag from './approach.frag?raw'

  function hexToVec3(hex: string): [number, number, number] {
    const clean = hex.trim().replace('#', '')
    return [
      Number.parseInt(clean.slice(0, 2), 16) / 255,
      Number.parseInt(clean.slice(2, 4), 16) / 255,
      Number.parseInt(clean.slice(4, 6), 16) / 255,
    ]
  }

  function getCircleColor(): [number, number, number] {
    const val = getComputedStyle(document.documentElement)
      .getPropertyValue('--color-gray-90')
      .trim()
    return hexToVec3(val)
  }

  function init() {
    const canvas = document.querySelector<HTMLCanvasElement>('#approach-canvas')
    if (!canvas) {
      return
    }

    const BASE_A = 0.44,
      BASE_B = 0.11
    const REF_ASP = 16 / 9
    const pA = [0, 0]
    const pB = [0, 0]
    let aspScale = 1

    const renderer = new Renderer({
      canvas,
      alpha: true,
      depth: false,
      stencil: false,
      antialias: false,
      premultipliedAlpha: false,
      dpr: Math.min(devicePixelRatio || 1, 2),
    })
    const gl = renderer.gl

    const program = new Program(gl, {
      vertex: vert,
      fragment: frag,
      uniforms: {
        uRes: { value: [0, 0] },
        uPA: { value: pA },
        uRA: { value: BASE_A },
        uPB: { value: pB },
        uRB: { value: BASE_B },
        uK: { value: 0 },
        uColor: { value: getCircleColor() },
      },
      transparent: true,
      depthTest: false,
      depthWrite: false,
    })
    const mesh = new Mesh(gl, { geometry: new Triangle(gl), program })

    const controller = new AbortController()
    const { signal } = controller

    const resizeObserver = new ResizeObserver(entries => {
      const { width, height } = entries[0]!.contentRect
      if (!width || !height) {
        return
      }
      renderer.setSize(width, height)
      Object.assign(canvas.style, { width: '', height: '' })
      program.uniforms.uRes.value = [
        gl.drawingBufferWidth,
        gl.drawingBufferHeight,
      ]
      const asp = gl.drawingBufferWidth / gl.drawingBufferHeight
      aspScale = Math.min(1, asp / REF_ASP)
      pA[0] = -asp / 4
      pB[0] = asp / 4
    })
    resizeObserver.observe(canvas)

    let t = 0,
      tgt = 0

    function lerp(a: number, b: number, s: number) {
      return a + (b - a) * s
    }

    function updateTgt(clientX: number) {
      const rect = canvas!.getBoundingClientRect()
      const asp = gl.drawingBufferWidth / gl.drawingBufferHeight
      const mx = ((clientX - rect.left) / rect.width - 0.5) * asp
      tgt = Math.max(0, Math.min(1, (mx - pA[0]) / (pB[0] - pA[0])))
    }

    canvas.addEventListener('mousemove', e => updateTgt(e.clientX), { signal })
    canvas.addEventListener(
      'mouseleave',
      () => {
        tgt = 0
      },
      { signal },
    )
    canvas.addEventListener(
      'touchmove',
      e => {
        e.preventDefault()
        updateTgt(e.touches[0]!.clientX)
      },
      { passive: false, signal },
    )
    canvas.addEventListener(
      'touchend',
      () => {
        tgt = 0
      },
      { signal },
    )

    let rafId = 0

    function render() {
      t = lerp(t, tgt, 0.022)
      const v = Math.max(0, Math.min(1, (t - 0.2) / 0.6))
      const tRad = v * v * (3 - 2 * v)

      program.uniforms.uRA.value = lerp(BASE_A, BASE_B, tRad) * aspScale
      program.uniforms.uRB.value = lerp(BASE_B, BASE_A, tRad) * aspScale
      program.uniforms.uK.value = 4 * t * (1 - t) * 1.7 * aspScale

      renderer.render({ scene: mesh })
      rafId = requestAnimationFrame(render)
    }

    rafId = requestAnimationFrame(render)

    /* const mq = window.matchMedia('(prefers-color-scheme: light)')
    mq.addEventListener(
      'change',
      () => {
        program.uniforms.uColor.value = getCircleColor()
      },
      { signal },
    ) */

    signal.addEventListener('abort', () => {
      cancelAnimationFrame(rafId)
      resizeObserver.disconnect()
    })

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
    })
  }

  document.addEventListener('astro:page-load', init)
</script>
