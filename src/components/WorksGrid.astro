---
import { getCollection } from 'astro:content'
import { Picture } from 'astro:assets'
import { seededShuffle } from '../lib/seededShuffle'

const projects = await getCollection('projects')
projects.sort((a, b) => a.data.order - b.data.order)

type Row = { projectId: string; filename: string }

const rows: Row[] = []
for (const entry of projects) {
  for (const filename of entry.data.images) {
    rows.push({ projectId: entry.id, filename })
  }
}

const shuffledRows = seededShuffle(rows, 42)
---

<div class="works-grid is-initializing" aria-label="Works">
  {
    shuffledRows.map(row => (
      <div class="wg-row">
        <a class="wg-item" href={`/works/${row.projectId}`}>
          <Picture
            src={`projects/${row.projectId}/images/${row.filename}`}
            formats={['avif', 'webp']}
            width={320}
            height={180}
            alt={row.projectId}
            sizes="320px"
          />
        </a>
      </div>
    ))
  }
</div>
<noscript>
  <style>
    .works-grid.is-initializing {
      visibility: visible;
    }
  </style>
</noscript>

<script>
  import {
    loadHoverPositions,
    loadScrollOffset,
    saveHoverPositions,
    saveScrollOffset,
  } from '../lib/positionStore'
  import { initVirtualScroll } from '../lib/worksVirtualScroll'
  import { initHover } from '../lib/worksHover'

  function init() {
    const grid = document.querySelector<HTMLElement>('.works-grid')
    if (!grid) {
      return
    }

    const rows = [...grid.querySelectorAll<HTMLElement>('.wg-row')]
    if (rows.length === 0) {
      return
    }

    // Take over scroll restoration: browser would otherwise restore the inner
    // container's scrollTop AFTER our seek, racing the virtualizer.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual'
    }

    const scroll = initVirtualScroll(grid, rows, loadScrollOffset())
    const hover = initHover(grid, rows, loadHoverPositions())

    grid.classList.remove('is-initializing')

    function persist() {
      saveHoverPositions(hover.getCurrentPositions())
      saveScrollOffset(scroll.getScrollOffset())
    }

    function onVisibilityChange() {
      if (document.visibilityState === 'hidden') {
        persist()
      }
    }

    window.addEventListener('pagehide', persist)
    document.addEventListener('visibilitychange', onVisibilityChange)

    document.addEventListener(
      'astro:before-swap',
      () => {
        persist()
        scroll.destroy()
        hover.destroy()
        window.removeEventListener('pagehide', persist)
        document.removeEventListener('visibilitychange', onVisibilityChange)
      },
      { once: true },
    )
  }

  document.addEventListener('astro:page-load', init)
</script>

<style>
  @import '../styles/media.css';

  .works-grid {
    --col-width: calc(
      (100% - (var(--cols) - 1) * var(--col-gap)) / var(--cols) * 3 +
        var(--col-gap) * 2
    );
    /* Grid layout for SSR/no-JS fallback; JS switches to display:block after measuring */
    display: grid;
    grid-auto-rows: min-content;
    row-gap: var(--col-gap);
    /* Positioned ancestor for absolutely placed rows after JS init */
    position: relative;
    padding: var(--space-2xl) var(--page-pad) 0;
    /* Scroll container — momentum scroll works natively, no window hacks */
    height: 100dvh;
    overflow-y: scroll;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  /* JS sets this before measuring; cleared once virtualization is in place.
     Avoids a one-frame flash at scrollTop=0 on every navigation. */
  .works-grid.is-initializing {
    visibility: hidden;
  }

  .wg-row {
    width: 100%;
    overflow: hidden;
    will-change: transform;
  }

  .wg-item {
    display: block;
    width: var(--col-width);
    will-change: transform;
    text-decoration: none;
  }

  .wg-item :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  /* Spacer: in normal flow, sets scrollHeight for virtual scroll */
  .wg-spacer {
    width: 1px;
    pointer-events: none;
    visibility: hidden;
  }
</style>
