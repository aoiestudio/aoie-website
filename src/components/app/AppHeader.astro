---
import HireButton from '@/components/buttons/HireButton.astro'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isStudio = pathname === '/'
const isWorks = pathname === '/works' || pathname.startsWith('/works/')
const isExplore = pathname === '/explore'
---

<header class="nav page-wrap section-grid">
  <a href="/" class="col-label nav-logo text-heading">aoie</a>
  <div class="col-content nav-right text-body">
    <nav class="nav-links" aria-label="Main">
      <a href="/" class:list={['nav-link', isStudio && 'is-active']}>Studio</a>
      <a href="/works" class:list={['nav-link', isWorks && 'is-active']}>
        Works
      </a>
      <a
        href="https://www.cosmos.so/aoiestudio"
        class="nav-link"
        target="_blank"
        rel="noopener"
      >
        Lab
      </a>
    </nav>
    <HireButton class="nav-hire link" />
    {
      !isExplore && (
        <a href="/explore" class="nav-burger" aria-label="Explore">
          <div class="nav-burger__icon" aria-hidden="true">
            <div class="nav-burger__line" />
            <div class="nav-burger__line" />
          </div>
        </a>
      )
    }
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    align-items: start;
    padding-top: var(--2-lh);
    mix-blend-mode: difference;
  }

  .nav-logo {
    line-height: 1;
    margin-top: -6px;
  }

  .nav-right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--2-lh);
  }

  .nav-burger {
    display: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-burger:hover {
    opacity: 0.85;
  }

  .nav-burger:focus-visible {
    outline: 1px solid var(--color-gray-40);
    outline-offset: 4px;
  }

  .nav-burger__icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: calc(
      (100vw - 2 * var(--page-pad) - (var(--cols) - 1) * var(--col-gap)) /
        var(--cols)
    );
  }

  .nav-burger__line {
    height: 1px;
    background: currentColor;
  }

  .nav-links {
    display: flex;
    gap: var(--2-lh);
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link.is-active {
    color: var(--color-text-inverse);
  }

  .nav-link:hover {
    color: var(--color-text-inverse);
  }

  .nav-link--disabled {
    pointer-events: none;
    color: var(--color-gray-40);
  }

  /* @media (prefers-color-scheme: light) {
    .nav {
      mix-blend-mode: normal;
    }
  } */

  @media (--mobile) {
    .nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .nav-right {
      width: auto;
      flex: 0 0 auto;
      margin-left: auto;
      justify-content: flex-end;
    }

    .nav-links {
      display: none;
    }

    .nav-hire {
      display: none;
    }

    .nav-burger {
      display: inline-flex;
    }
  }
</style>
