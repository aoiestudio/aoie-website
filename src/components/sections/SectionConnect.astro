---
import BaseSection from '@/components/base/BaseSection.astro'
---

<BaseSection title="Connect" id="connect" class="section-connect">
  <div class="connect-grid">
    <div class="connect-col">
      <span class="text-body connect-label">Contact</span>
      <div class="connect-item">
        <span class="text-body connect-key">Business enquiries</span>
        <a href="mailto:hello@aoie.studio" class="text-body connect-val link">
          hello@aoie.studio
        </a>
      </div>
      <div class="connect-item">
        <span class="text-body connect-key">Careers</span>
        <a href="mailto:careers@aoie.studio" class="text-body connect-val link">
          careers@aoie.studio
        </a>
      </div>
    </div>
    <div class="connect-col">
      <span class="text-body connect-label">Follow</span>
      <div class="connect-links">
        <a
          href="https://www.linkedin.com/company/aoie"
          class="text-body connect-val link"
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
        <a
          href="https://instagram.com/aoiestudio"
          class="text-body connect-val link"
          target="_blank"
          rel="noopener"
        >
          Instagram
        </a>
        <a
          href="https://behance.net/aoie"
          class="text-body connect-val link"
          target="_blank"
          rel="noopener"
        >
          Behance
        </a>
        <a
          href="https://x.com/aoiestudio"
          class="text-body connect-val link"
          target="_blank"
          rel="noopener"
        >
          X (Twitter)
        </a>
      </div>
    </div>
  </div>
</BaseSection>

<style>
  .connect-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--col-gap);
  }

  .connect-col {
    display: flex;
    flex-direction: column;
    gap: var(--2-lh);
  }

  .connect-label {
    color: var(--color-text);
  }

  .connect-item {
    display: flex;
    flex-direction: column;
  }

  .connect-key {
    color: var(--color-text);
  }

  .connect-links {
    display: flex;
    flex-direction: column;
  }

  :global(.section-connect) {
    min-height: var(--size-section);
    scroll-margin-top: var(--space-md);
  }

  @media (--mobile) {
    .connect-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg) 0;
    }

    .connect-col:nth-child(n + 2) {
      box-shadow: inset 0 1px 0 0 var(--color-gray-30);
      padding-top: var(--2-lh);
    }
  }
</style>
