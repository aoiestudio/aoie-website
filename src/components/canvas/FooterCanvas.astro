<canvas id="footer-canvas"></canvas>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { Renderer, Program, Mesh, Triangle, Texture } from 'ogl'
  import vert from './hero-media.vert?raw'
  import frag from './footer.frag?raw'

  const CELL = 22
  const STRIP = 1
  const MAX_ROWS = 64

  function loadImg(src: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image()
      img.addEventListener('load', () => resolve(img))
      img.addEventListener('error', reject)
      img.crossOrigin = 'anonymous'
      img.src = src
    })
  }

  function hexToVec3(hex: string): [number, number, number] {
    const clean = hex.trim().replace('#', '')
    return [
      Number.parseInt(clean.slice(0, 2), 16) / 255,
      Number.parseInt(clean.slice(2, 4), 16) / 255,
      Number.parseInt(clean.slice(4, 6), 16) / 255,
    ]
  }

  function getTextColor(): [number, number, number] {
    const val = getComputedStyle(document.documentElement)
      .getPropertyValue('--color-text-muted')
      .trim()
    return hexToVec3(val)
  }

  async function init() {
    const stage = document.querySelector<HTMLElement>('[data-footer-canvas]')
    const canvas = document.querySelector<HTMLCanvasElement>('#footer-canvas')
    if (!stage || !canvas) {
      return
    }

    const renderer = new Renderer({
      canvas,
      alpha: true,
      depth: false,
      stencil: false,
      antialias: false,
      premultipliedAlpha: true,
      dpr: Math.min(devicePixelRatio || 1, 2),
    })
    const gl = renderer.gl

    const rowEnergy = new Float32Array(MAX_ROWS)
    const energyTex = new Texture(gl, {
      image: rowEnergy,
      width: MAX_ROWS,
      height: 1,
      internalFormat: (gl as WebGL2RenderingContext).R32F,
      format: (gl as WebGL2RenderingContext).RED,
      type: gl.FLOAT,
      generateMipmaps: false,
      minFilter: gl.NEAREST,
      magFilter: gl.NEAREST,
    })

    const symbol = await loadImg('/sdf/dash.png')
    const symbolTex = new Texture(gl, {
      image: symbol,
      generateMipmaps: true,
      minFilter: gl.LINEAR,
      magFilter: gl.LINEAR,
      wrapS: gl.CLAMP_TO_EDGE,
      wrapT: gl.CLAMP_TO_EDGE,
    })

    const program = new Program(gl, {
      vertex: vert,
      fragment: frag,
      uniforms: {
        uRes: { value: [0, 0] },
        uDpr: { value: renderer.dpr },
        uCell: { value: CELL },
        uStrip: { value: STRIP },
        uColor: { value: getTextColor() },
        uEnergy: { value: energyTex },
        uSymbol: { value: symbolTex },
      },
      depthTest: false,
      depthWrite: false,
    })

    const mesh = new Mesh(gl, { geometry: new Triangle(gl), program })

    const controller = new AbortController()
    const { signal } = controller

    const resizeObserver = new ResizeObserver(entries => {
      const { width, height } = entries[0]!.contentRect
      if (!width || !height) {
        return
      }
      renderer.setSize(width, height)
      Object.assign(canvas.style, { width: '', height: '' })
      program.uniforms.uRes.value = [width, height]
      program.uniforms.uDpr.value = renderer.dpr
    })
    resizeObserver.observe(stage)

    const touchQuery = window.matchMedia('(hover: none) and (pointer: coarse)')
    let isTouch = touchQuery.matches
    touchQuery.addEventListener(
      'change',
      e => {
        isTouch = e.matches
      },
      { signal },
    )

    /* const mq = window.matchMedia('(prefers-color-scheme: light)')
    mq.addEventListener(
      'change',
      () => {
        program.uniforms.uColor.value = getTextColor()
      },
      { signal },
    ) */

    let hovering = false,
      my = 0,
      prevMy = 0,
      prevMyTimeout = 0
    let prevTouchY = -1
    let lastRender = performance.now()

    canvas.addEventListener(
      'mousemove',
      e => {
        const r = canvas.getBoundingClientRect()
        prevMy = my
        my = e.clientY - r.top
        hovering = true
        if (prevMyTimeout <= 0) {
          prevMy = my
        }
        prevMyTimeout = 10
      },
      { signal },
    )

    canvas.addEventListener(
      'mouseleave',
      () => {
        hovering = false
      },
      { signal },
    )

    let rafId = 0

    function render() {
      const now = performance.now()
      const dt = (now - lastRender) * 0.001
      lastRender = now

      const decayFactor = Math.exp(-dt * 5)
      for (let i = 0; i < MAX_ROWS; i++) {
        rowEnergy[i] *= decayFactor
      }

      if (isTouch) {
        const rect = canvas!.getBoundingClientRect()
        const centerY = window.innerHeight - rect.top
        if (centerY >= 0 && centerY < rect.height) {
          const r0 =
            prevTouchY >= 0
              ? Math.min(Math.floor(prevTouchY / CELL), MAX_ROWS - 1)
              : Math.min(Math.floor(centerY / CELL), MAX_ROWS - 1)
          const r1 = Math.min(Math.floor(centerY / CELL), MAX_ROWS - 1)
          const lo = Math.min(r0, r1)
          const hi = Math.max(r0, r1)
          for (let i = lo; i <= hi; i++) {
            rowEnergy[i] = 1
          }
          prevTouchY = centerY
        } else {
          prevTouchY = -1
        }
      } else if (hovering) {
        const r0 = Math.min(Math.floor(prevMy / CELL), MAX_ROWS - 1)
        const r1 = Math.min(Math.floor(my / CELL), MAX_ROWS - 1)
        const lo = Math.min(r0, r1)
        const hi = Math.max(r0, r1)
        for (let i = lo; i <= hi; i++) {
          rowEnergy[i] = 1
        }
      }

      if (prevMyTimeout > 0) {
        prevMyTimeout -= 1
        prevMy = my
      }

      energyTex.needsUpdate = true
      renderer.render({ scene: mesh })
      rafId = requestAnimationFrame(render)
    }

    rafId = requestAnimationFrame(render)

    signal.addEventListener('abort', () => {
      cancelAnimationFrame(rafId)
      resizeObserver.disconnect()
    })

    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
    })
  }

  document.addEventListener('astro:page-load', init)
</script>
