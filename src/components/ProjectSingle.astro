---
import { Picture } from 'astro:assets'

interface Props {
  filename: string
  alt?: string
  /** Override the project slug. Defaults to Astro.locals.project set by the works/[id] page. */
  project?: string
  /** Mark the above-the-fold hero image: sets eager loading and high fetch priority for LCP. */
  priority?: boolean
}

const {
  filename,
  alt = '',
  project = Astro.locals.project ?? '',
  priority = false,
} = Astro.props
---

<div class="project-single">
  <Picture
    src={`projects/${project}/images/${filename}`}
    formats={['avif', 'webp']}
    width={1200}
    height={800}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</div>

<style>
  .project-single {
    width: 100%;
  }

  .project-single :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
