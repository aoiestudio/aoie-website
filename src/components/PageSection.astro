---
interface Props {
  title: string
  mode?: 'half-width' | 'full-width' | 'bottom'
  class?: string
  id?: string
}

const { title, mode = 'half-width', class: className, id } = Astro.props
---

{
  mode === 'bottom' ? (
    <section id={id} class:list={['page-section', 'page-wrap', className]}>
      <div class="page-section__head">
        <hr class="page-section__divider" />
        <h2 class="text-heading page-section__title">{title}</h2>
        <slot name="subtitle" />
      </div>
      <slot />
    </section>
  ) : mode === 'full-width' ? (
    <section
      id={id}
      class:list={[
        'page-section',
        'page-section--full',
        'page-wrap',
        className,
      ]}
    >
      <hr class="page-section__divider" />
      <div class="section-grid">
        <h2 class="col-label text-heading page-section__title">{title}</h2>
      </div>
      <slot />
    </section>
  ) : (
    <section
      id={id}
      class:list={[
        'page-section',
        'page-section--half',
        'page-wrap',
        className,
      ]}
    >
      <hr class="page-section__divider" />
      <div class="section-grid">
        <h2 class="col-label text-heading page-section__title">{title}</h2>
        <div class="col-content page-section__slot">
          <slot />
        </div>
      </div>
    </section>
  )
}

<style>
  .page-section {
  }

  .page-section__divider {
    border: none;
    height: 1px;
    background: var(--color-gray-30);
    margin: 0 0 calc(var(--2-lh) - 1px);
  }

  .page-section__title {
    color: var(--color-text);
  }

  .page-section__slot {
  }

  @media (--mobile) {
    .page-section--half .page-section__title {
      height: var(--space-xl);
      display: flex;
      align-items: flex-start;
      box-shadow: inset 0 -1px 0 0 var(--color-gray-30);
      margin-bottom: var(--space-sm);
    }

    .page-section--full .page-section__title {
      margin-bottom: 0;
    }
  }
</style>
