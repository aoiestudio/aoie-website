---
import { getCollection } from 'astro:content'
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { seededShuffle } from '../lib/seededShuffle'

const projects = await getCollection('projects')
projects.sort((a, b) => a.data.order - b.data.order)

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/projects/*/images/*.{jpg,jpeg,png}',
  { eager: true },
)

type Row = {
  projectId: string
  image: ImageMetadata
}

const rows: Row[] = []
for (const [path, mod] of Object.entries(allImages)) {
  const match = path.match(/content\/projects\/([^/]+)\/images\//)
  if (match) {
    rows.push({ projectId: match[1]!, image: mod.default })
  }
}

const shuffledRows = seededShuffle(rows, 42)
---

<div class="works-grid" aria-label="Works">
  {
    shuffledRows.map(row => (
      <div class="wg-row">
        <a class="wg-item" href={`/works/${row.projectId}`}>
          <Picture
            src={row.image}
            formats={['avif', 'webp']}
            width={320}
            height={180}
            loading="lazy"
            alt={row.projectId}
          />
        </a>
      </div>
    ))
  }
</div>

<script>
  import { loadPositions, savePositions } from '../lib/positionStore'
  import { initVirtualScroll } from '../lib/worksVirtualScroll'
  import { initHover } from '../lib/worksHover'

  function init() {
    const grid = document.querySelector<HTMLElement>('.works-grid')
    if (!grid) {
      return
    }

    const rows = [...grid.querySelectorAll<HTMLElement>('.wg-row')]
    if (rows.length === 0) {
      return
    }

    const saved = loadPositions()

    const scroll = initVirtualScroll(grid, rows)
    const hover = initHover(grid, rows, saved, savePositions)

    function onVisibilityChange() {
      if (document.visibilityState === 'hidden') {
        hover.saveCurrentPositions()
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange)

    document.addEventListener(
      'astro:before-swap',
      () => {
        scroll.destroy()
        hover.destroy()
        document.removeEventListener('visibilitychange', onVisibilityChange)
      },
      { once: true },
    )
  }

  document.addEventListener('astro:page-load', init)
</script>

<style>
  @import '../styles/media.css';

  .works-grid {
    --col-width: calc(
      (100% - (var(--cols) - 1) * var(--col-gap)) / var(--cols) * 3 +
        var(--col-gap) * 2
    );
    /* Grid layout for SSR/no-JS fallback; JS switches to display:block after measuring */
    display: grid;
    grid-auto-rows: min-content;
    row-gap: var(--col-gap);
    /* Positioned ancestor for absolutely placed rows after JS init */
    position: relative;
    padding: var(--space-2xl) var(--page-pad) 0;
    /* Scroll container — momentum scroll works natively, no window hacks */
    height: 100dvh;
    overflow-y: scroll;
    overflow-x: hidden;
    overscroll-behavior: contain;
  }

  .wg-row {
    width: 100%;
    overflow: hidden;
    will-change: transform;
  }

  .wg-item {
    display: block;
    width: var(--col-width);
    will-change: transform;
    text-decoration: none;
  }

  .wg-item :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  /* Spacer: in normal flow, sets scrollHeight for virtual scroll */
  .wg-spacer {
    width: 1px;
    pointer-events: none;
    visibility: hidden;
  }
</style>
