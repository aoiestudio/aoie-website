---
import HireButton from './HireButton.astro'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isStudio = pathname === '/'
const isWorks = pathname === '/works' || pathname.startsWith('/works/')
---

<header class="nav page-wrap section-grid">
  <a href="/" class="col-label nav-logo text-heading">aoie</a>
  <div class="col-content nav-right text-body">
    <nav class="nav-links" aria-label="Main">
      <a href="/" class:list={['nav-link', isStudio && 'is-active']}>Studio</a>
      <a href="/works" class:list={['nav-link', isWorks && 'is-active']}
        >Works</a
      >
    </nav>
    <HireButton class="nav-hire link" />
    <a href="/explore" class="nav-burger" aria-label="Explore">
      <svg
        class="nav-burger__icon"
        width="49"
        height="6"
        viewBox="0 0 49 6"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        {
          Array.from({ length: 12 }, (_, index) => (
            <rect x={1.5 + index * 4} y="0" width="2" height="6" rx="1" />
          ))
        }
      </svg>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    align-items: start;
    padding-top: var(--2-lh);
    mix-blend-mode: difference;
  }

  .nav-logo {
    line-height: 1;
    margin-top: -6px;
  }

  .nav-right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--2-lh);
  }

  .nav-burger {
    display: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-burger:hover {
    opacity: 0.85;
  }

  .nav-burger:focus-visible {
    outline: 1px solid var(--color-gray-40);
    outline-offset: 4px;
  }

  .nav-burger__icon {
    display: block;
  }

  .nav-links {
    display: flex;
    gap: var(--2-lh);
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link.is-active {
    color: var(--color-text-inverse);
  }

  .nav-link:hover {
    color: var(--color-text-inverse);
  }

  .nav-link--disabled {
    pointer-events: none;
    color: var(--color-gray-40);
  }

  @media (prefers-color-scheme: light) {
    .nav {
      mix-blend-mode: normal;
    }
  }

  @media (--mobile) {
    .nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .nav-right {
      width: auto;
      flex: 0 0 auto;
      margin-left: auto;
      justify-content: flex-end;
    }

    .nav-links {
      display: none;
    }

    .nav-hire {
      display: none;
    }

    .nav-burger {
      display: inline-flex;
    }
  }
</style>
