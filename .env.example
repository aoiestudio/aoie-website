# ── Image mode ────────────────────────────────────────────────────────────────
# "local"   → dev endpoint src/pages/_img/[...path].ts reads from local disk
# "imgproxy" → signed imgproxy URLs via @imgproxy/imgproxy-node
PUBLIC_IMAGE_MODE=local

# ── S3 (both dev and prod) ─────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=aoie-originals
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── imgproxy (prod only) ───────────────────────────────────────────────────────
# Base URL that Caddy exposes: https://yourdomain.com/_img
IMGPROXY_ENDPOINT=https://yourdomain.com/_img
# Generate with: xxd -g 2 -l 64 -p /dev/random | tr -d '\n'
IMGPROXY_KEY=
IMGPROXY_SALT=

# ── Contact form (prod only) ───────────────────────────────────────────────────
RESEND_API_KEY=

# ── Deployment ─────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
