---
import BrandingSection from './BrandingSection.astro'
import ConnectSection from './ConnectSection.astro'
---

<footer class="footer">
  <div class="footer-sections">
    <ConnectSection />
    <BrandingSection />
  </div>
  <div class="footer-canvas"></div>
</footer>

<style>
  .footer-sections {
    display: flex;
    flex-direction: column;
  }

  .footer-canvas {
    height: var(--66-lh);
    background: var(--color-surface);
    margin-inline: var(--page-pad);
  }
</style>
