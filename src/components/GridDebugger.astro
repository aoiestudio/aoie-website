---

---

<div class="debugger" id="debugger">
  <div class="debugger-cols" id="debugger-cols"></div>
</div>

<script>
  let controller: AbortController | null = null

  document.addEventListener('astro:page-load', () => {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller

    const grid = document.querySelector<HTMLElement>('#debugger')
    const cols = document.querySelector<HTMLElement>('#debugger-cols')

    if (!grid || !cols) {
      return
    }

    const tablet = window.matchMedia('(min-width: 769px)')
    const desktop = window.matchMedia('(min-width: 1025px)')
    const wide = window.matchMedia('(min-width: 1441px)')

    function updateCols() {
      let count = 4
      if (tablet.matches) {
        count = 8
      }
      if (desktop.matches) {
        count = 14
      }
      if (wide.matches) {
        count = 18
      }
      cols!.innerHTML = Array.from({ length: count })
        .map(() => '<div></div>')
        .join('')
    }

    function updateHeight() {
      grid!.style.height = document.documentElement.scrollHeight + 'px'
    }

    tablet.addEventListener('change', updateCols, { signal })
    desktop.addEventListener('change', updateCols, { signal })
    wide.addEventListener('change', updateCols, { signal })

    const ro = new ResizeObserver(() => {
      updateHeight()
      updateCols()
    })
    ro.observe(document.documentElement)
    signal.addEventListener('abort', () => ro.disconnect())

    updateHeight()
    updateCols()
  })

  document.addEventListener('keydown', e => {
    const tag = (e.target as HTMLElement).tagName
    if (tag === 'INPUT' || tag === 'TEXTAREA') {
      return
    }
    if (e.code === 'KeyG' && e.ctrlKey && !e.metaKey && !e.altKey) {
      document.querySelector('#debugger')?.classList.toggle('--active')
    }
  })
</script>

<style>
  .debugger {
    background-image: linear-gradient(180deg, grey 0.5px, transparent 0);
    background-size: var(--lh) var(--lh);
    display: none;
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 999999;
  }

  .debugger.--active {
    display: block;
  }

  .debugger-cols {
    display: flex;
    height: 100%;
    opacity: 0.15;
    /* outer border = page padding, inner col borders = half col-gap each side */
    border: var(--lh) solid var(--color-bg);
  }

  :global(.debugger-cols > div) {
    background: red;
    border: var(--lh) solid var(--color-bg);
    flex: 1;
  }
</style>
