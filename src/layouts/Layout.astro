---
import { ClientRouter } from 'astro:transitions'
import '../styles/preflight.css'
import '../styles/media.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/typography.css'
import '../styles/layout.css'
import GridDebugger from '../components/GridDebugger.astro'
import MobileBlock from '../components/MobileBlock.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply saved works-grid positions before first paint to prevent FOUC
      ;(function () {
        try {
          const raw = localStorage.getItem('works-positions')
          if (!raw) {return}
          const data = JSON.parse(raw)
          if (!data || data.width !== window.innerWidth || !Array.isArray(data.positions)) {return}
          const style = document.createElement('style')
          const rules = []
          const half = data.positions.length
          for (let i = 0; i < half * 2; i++) {
            const pos = data.positions[i % half]
            if (typeof pos === 'number') {
              rules.push('.wg-row:nth-child(' + (i + 1) + ') .wg-item{transform:translateX(' + pos + 'px)}')
            }
          }
          style.textContent = rules.join('')
          document.head.append(style)
        // oxlint-disable-next-line no-empty
        } catch {}
      })()
    </script>
  </head>
  <body>
    <slot />
    <MobileBlock />
    <GridDebugger />
  </body>
</html>
