---
import { Picture } from 'astro:assets'

interface Props {
  filename: string
  priority?: boolean
  /** Override the project slug. Defaults to Astro.locals.project set by the works/[id] page. */
  project?: string
}

const {
  filename,
  priority = false,
  project = Astro.locals.project ?? '',
} = Astro.props
---

<div class="project-single">
  <Picture
    src={`projects/${project}/images/${filename}`}
    formats={['avif', 'webp']}
    layout="full-width"
    inferSize
    priority={priority}
    alt=""
  />
</div>

<style>
  .project-single {
    width: 100%;
    background-size: cover;
    background-position: center;
  }

  .project-single :global(img) {
    display: block;
    transition: opacity 0.4s ease;
  }
</style>

<script>
  import { decode } from 'blurhash'

  function initBlurhash(scope: Document | Element = document) {
    scope
      .querySelectorAll<HTMLImageElement>('img[data-blurhash]')
      .forEach(img => {
        if (img.dataset.blurhashDone) {
          return
        }
        img.dataset.blurhashDone = 'true'

        const hash = img.dataset.blurhash!
        const container = img.closest<HTMLElement>('.project-single')
        if (!container) {
          return
        }

        const origW = Number(img.getAttribute('width')) || 16
        const origH = Number(img.getAttribute('height')) || 9
        const ratio = origH / origW
        const canvasW = 32
        const canvasH = Math.max(1, Math.round(canvasW * ratio))

        const pixels = decode(hash, canvasW, canvasH)
        const canvas = document.createElement('canvas')
        canvas.width = canvasW
        canvas.height = canvasH
        const ctx = canvas.getContext('2d')!
        ctx.putImageData(
          new ImageData(new Uint8ClampedArray(pixels), canvasW, canvasH),
          0,
          0,
        )
        container.style.backgroundImage = `url(${canvas.toDataURL()})`

        if (img.complete) {
          // already loaded (priority image or cached)
          container.style.backgroundImage = ''
        } else {
          img.style.opacity = '0'
          img.addEventListener(
            'load',
            () => {
              img.style.opacity = '1'
              img.addEventListener(
                'transitionend',
                () => {
                  container.style.backgroundImage = ''
                },
                { once: true },
              )
            },
            { once: true },
          )
        }
      })
  }

  initBlurhash()
  document.addEventListener('astro:page-load', () => initBlurhash())
</script>
