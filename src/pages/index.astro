---
import { getCollection } from 'astro:content'
import ApproachCanvas from '@/components/canvas/ApproachCanvas.astro'
import HeroCanvas from '@/components/canvas/HeroCanvas.astro'
import BaseClock from '@/components/base/BaseClock.astro'
import BaseCard from '@/components/base/BaseCard.astro'
import BaseRow from '@/components/base/BaseRow.astro'
import { buildImageUrl } from '@/lib/build-image-url'
import PageLayout from '@/layouts/PageLayout.astro'
import BaseSection from '@/components/base/BaseSection.astro'

const projects = await getCollection('projects')
const firstHeroImage = projects
  .filter(p => p.data.hero?.length)
  .toSorted((a, b) => a.data.order - b.data.order)
  .flatMap(p =>
    p.data.hero!.map(f => buildImageUrl(`projects/${p.id}/images/${f}`)),
  )[0]
---

<PageLayout
  title="aoie — design studio"
  description="Independent design studio. We absorb visual noise and build clear brand identities — from concept to implementation."
>
  {
    firstHeroImage && (
      <link
        rel="preload"
        slot="head"
        as="image"
        href={firstHeroImage}
        fetchpriority="high"
        crossorigin="anonymous"
      />
    )
  }
  <!-- Top: hero + hero-media grouped with 16lh gap (Figma "Top" node) -->
  <div class="hero-top">
    <section class="hero page-wrap">
      <h1 class="text-heading hero-text prose-indent">
        is a design studio that absorbs visual noise and builds a clear identity
        from concept to implementation. We are a response to a world where
        attention has become scarce and visual noise is the norm. Independence
        and flexibility over diffused responsibility. Direct dialogue over
        chains of approval.
      </h1>
    </section>
    <div class="hero-media page-wrap">
      <HeroCanvas />
    </div>
  </div>

  <!-- Information -->
  <BaseSection title="Information">
    <div class="info-content">
      <BaseRow borderTop={false}>
        <div class="info-block info-block--first">
          <BaseCard title="Working globally" tight>
            <span id="info-clock">
              <BaseClock />
              <span class="info-clock-tz">CET</span>
            </span>
          </BaseCard>
        </div>
        <div class="info-block info-block--first">
          <BaseCard title="Ownership" description="Independent" tight />
          <BaseCard title="Founded" description="2025" tight />
        </div>
      </BaseRow>
      <BaseRow>
        <BaseCard title="Capabilities">
          <ul class="info-list text-body">
            <li>Creative Direction</li>
            <li>Strategy</li>
            <li>Visual Identity</li>
            <li>Graphic Design</li>
            <li>Motion Design</li>
            <li>Digital Design</li>
            <li>Campaign</li>
            <li>Narrative</li>
          </ul>
        </BaseCard>
        <BaseCard
          title="Experience"
          description="Over 20 combined years of experience in design, built through deep involvement in business, development, and marketing. We've operated in all three — and kept art at the core of everything."
        />
      </BaseRow>
      <BaseRow>
        <div class="info-person">
          <BaseCard title="Anna Sharapova">
            <span class="text-body"
              >Co-Founder, Designer Director<br />16 years experience</span
            >
          </BaseCard>
          <div class="info-photo"></div>
        </div>
        <div class="info-person">
          <BaseCard title="Eduard Aksamitov">
            <span class="text-body"
              >Co-Founder, Art Director<br />10 years experience</span
            >
          </BaseCard>
          <div class="info-photo"></div>
        </div>
      </BaseRow>
    </div>
  </BaseSection>

  <!-- Approach -->
  <BaseSection title="Approach" mode="full-width">
    <p class="text-heading approach-text prose-indent">
      Acting at the intersection of strategy and visual design, our work spans
      from research to finished product and everything in between. An officeless
      team where every project is led by those who create it. And beyond —
      through implementation, until the identity becomes reality. The client has
      a business, ambitions, a chaos of ideas and references. We ask questions,
      dig deep, strip away the excess — until only what works remains. From
      noise comes clarity that lasts for years. This is the distillation of
      essence.
    </p>
    <ApproachCanvas />
    <div class="section-grid">
      <div class="col-content approach-content">
        <BaseRow>
          <BaseCard
            title="Sense"
            description="Before anything takes shape, we need to understand what we're actually solving. We ask questions about your business, your audience, and the gap between where you are and where you want to be. Sometimes that's a single conversation. Sometimes it's a structured session. Either way, it ends with something most projects skip: clarity you can actually build from."
          />
          <BaseCard
            title="Shape"
            description="This is where the brand gets its form — the mark, the system, the visual language. We build from intention, not intuition alone. Every decision has a reason, and the result is something that holds together under pressure: across formats, across teams, across time. We work from scratch or on top of what exists — in full or with precision."
          />
        </BaseRow>
        <BaseRow>
          <BaseCard
            title="Press"
            description="Design doesn't end at the file handoff. We see it through — guiding developers, tightening details, catching what gets lost between intent and implementation. And when the brand needs to exist beyond the screen, we know how to get it there. We work closely with print production, understand material constraints, and make sure what was designed survives contact with the real world."
          />
          <BaseCard
            title="Stay"
            description="Some clients need a partner who's just there. For questions, reviews, small refinements, and strategic moments — even after another studio's work. We're available on retainer, hourly, or by the task. No long commitments required. We stay as long as we're useful."
          />
        </BaseRow>
      </div>
    </div>
  </BaseSection>

  <!-- Offers -->
  <BaseSection title="Offers" mode="full-width">
    <p class="text-heading offers-intro prose-indent">
      We don't do rush jobs or undefined scopes. Good design takes time, and
      good collaboration takes structure. Depending on what you need, we work
      one of two ways — both designed to keep things clear, calm, and moving
      forward.
    </p>
    <div class="section-grid">
      <div class="col-content offers-content">
        <BaseRow>
          <BaseCard
            title="Retainers"
            description="In close collaboration with you and your internal team, we work a set number of days per week over an extended period, where the length of it varies according to needs and deliverables. Through conversations tasks are defined and planned weekly."
          />
          <BaseCard
            title="Projects"
            description="One project at a time with a fixed total cost based on deliverables. The project is planned, estimated, and deliverables specified before the project starts up."
          />
        </BaseRow>
        <BaseRow>
          <BaseCard
            title="Consultancy"
            description="A focused conversation, not a deliverable. We help you understand a problem, evaluate a direction, or get unstuck. One or several sessions, depending on what you need. Suitable when you have a team but need an outside perspective, or when you're not sure yet what kind of help you actually need."
          />
        </BaseRow>
      </div>
    </div>
  </BaseSection>
</PageLayout>

<style>
  .hero-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hero {
    padding-top: var(--space-2xl);
  }

  .hero-text {
    max-width: 100%;
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: var(--2-lh);
    box-shadow: inset 0 1px 0 0 var(--color-border);
    padding-top: var(--lh);
  }

  .info-block--first {
    box-shadow: none;
    padding-top: 0;
  }

  #info-clock {
    display: inline-flex;
    align-items: baseline;
    gap: 11px;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .info-list li {
    line-height: var(--line-height-body);
  }

  .info-person {
    display: flex;
    flex-direction: column;
    gap: var(--2-lh);
  }

  .info-photo {
    background: var(--color-surface);
    aspect-ratio: 1;
    width: var(--32-lh);
  }

  .approach-text {
    margin-bottom: var(--space-lg);
  }

  .approach-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .offers-intro {
    margin-bottom: var(--space-lg);
  }

  .offers-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>
