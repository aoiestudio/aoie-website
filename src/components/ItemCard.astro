---
interface Props {
  title: string
  description?: string
  tight?: boolean
}

const { title, description, tight = false } = Astro.props
---

<div class:list={['item-card', { 'item-card--tight': tight }]}>
  <span class="text-body item-card-title">{title}</span>
  {description
    ? <p class="text-body item-card-content">{description}</p>
    : <div class="item-card-content"><slot /></div>
  }
</div>

<style>
  .item-card {
    display: flex;
    flex-direction: column;
    gap: var(--2-lh);
  }

  .item-card--tight {
    gap: 0;
  }

  .item-card-title {
    color: var(--color-text);
  }

  .item-card-content {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
</style>
