# image mode
# "local"    → src/pages/img/[...path].ts reads from local disk
# "imgproxy" → signed imgproxy URLs via @imgproxy/imgproxy-node
PUBLIC_IMAGE_MODE=local

# s3
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_BUCKET=aoie
S3_ACCESS_KEY=
S3_SECRET_KEY=

# imgproxy
# IMGPROXY_ENDPOINT=
# IMGPROXY_KEY=
# IMGPROXY_SALT=
