---
import { Picture } from 'astro:assets'

interface Props {
  filename: string
  priority?: boolean
  /** Override the project slug. Defaults to Astro.locals.project set by the works/[id] page. */
  project?: string
}

const {
  filename,
  priority = false,
  project = Astro.locals.project ?? '',
} = Astro.props
---

<div class="project-single">
  <Picture
    src={`projects/${project}/images/${filename}`}
    formats={['avif', 'webp']}
    layout="full-width"
    inferSize
    priority={priority}
    alt=""
  />
</div>

<style>
  .project-single {
    width: 100%;
  }

  .project-single :global(img) {
    display: block;
  }
</style>
