---
import PageSection from './PageSection.astro'
import HireButton from './HireButton.astro'
import BookCallButton from './BookCallButton.astro'
---

<PageSection
  title="Do you want to talk about branding?"
  mode="bottom"
  class="branding-section"
>
  <a
    slot="subtitle"
    href="mailto:hello@aoie.studio"
    class="text-heading footer-email link">hello@aoie.studio</a
  >
  <div class="footer-bar section-grid">
    <p class="text-body footer-legal">
      We're open for business and new collaborations from May 2026
    </p>
    <div class="footer-links">
      <BookCallButton class="text-body footer-book link" />
      <HireButton class="text-body footer-hire link" />
    </div>
    <span class="text-body footer-copy">©</span>
  </div>
</PageSection>

<style>
  :global(.page-section--bottom.branding-section) {
    padding-bottom: var(--2-lh);
  }

  .footer-email {
    display: block;
  }

  .footer-bar {
    align-items: end;
  }

  .footer-legal {
    color: var(--color-text);
    grid-column: 1 / 4;
  }

  .footer-links {
    display: flex;
    gap: var(--2-lh);
    grid-column: 5 / 7;
    align-self: end;
  }

  .footer-copy {
    color: var(--color-text);
    grid-column: 4 / 5;
    text-align: right;
  }

  @media (--sm) {
    .footer-copy {
      grid-column: 8 / 9;
    }
  }

  @media (--md) {
    .footer-copy {
      grid-column: 14 / 15;
    }
  }

  @media (--lg) {
    .footer-copy {
      grid-column: 18 / 19;
    }
  }

  @media (--mobile) {
    .footer-bar {
      display: flex;
      flex-wrap: wrap;
      gap: var(--2-lh) var(--col-gap);
    }

    .footer-legal {
      width: 100%;
    }

    .footer-links {
      flex: 1;
    }

    .footer-copy {
      flex: 0;
    }
  }
</style>
