---
import { Picture } from 'astro:assets'

interface Props {
  filename: string
  alt?: string
  /** Override the project slug. Defaults to Astro.locals.project set by the works/[id] page. */
  project?: string
}

const { filename, alt = '', project = Astro.locals.project ?? '' } = Astro.props
---

<div class="project-single">
  <Picture
    src={`projects/${project}/images/${filename}`}
    formats={['avif', 'webp']}
    alt={alt}
  />
</div>

<style>
  .project-single {
    width: 100%;
  }

  .project-single :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
