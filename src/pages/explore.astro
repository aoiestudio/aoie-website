---
import { getCollection } from 'astro:content'
import { Picture } from 'astro:assets'
import BookCallButton from '@/components/buttons/BookCallButton.astro'
import HireButton from '@/components/buttons/HireButton.astro'
import PageLayout from '@/layouts/PageLayout.astro'

const projects = await getCollection('projects')
const allImages = projects
  .filter(p => p.data.selected?.length)
  .toSorted((a, b) => a.data.order - b.data.order)
  .flatMap(p =>
    p.data.selected!.map(filename => ({ projectId: p.id, filename })),
  )
---

<PageLayout title="Explore — aoie studio" hideFooter noindex>
  <section class="selected page-wrap">
    <nav class="selected-nav" aria-label="Explore">
      <a href="/" class="selected-link">Studio</a>
      <a href="/works" class="selected-link">Works</a>
      <a
        href="https://www.cosmos.so/aoiestudio"
        class="selected-link selected-link--lab"
        target="_blank"
        rel="noopener"
      >
        Laboratory<svg
          class="selected-star"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M6.08671 18L2.49711 15.9034L5.6185 11.25H0V6.75L5.6185 6.80114L2.49711 2.14773L6.08671 0L9.05202 4.96023L12.0173 0L15.6069 2.14773L12.3815 6.80114L18 6.75V11.25H12.3815L15.6069 15.9034L12.0173 18L9.05202 13.142L6.08671 18Z"
          >
          </path>
        </svg>
      </a>
    </nav>

    <div class="selected-media-wrap">
      <div class="selected-media" id="selected-media">
        {
          allImages.map((item, index) => (
            <div
              class:list={['selected-media__slide', index === 0 && 'is-active']}
              data-selected-img
            >
              <Picture
                src={`projects/${item.projectId}/images/${item.filename}`}
                formats={['avif', 'webp']}
                width={640}
                height={360}
                sizes="640px"
                loading={index === 0 ? 'eager' : 'lazy'}
                alt=""
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="selected-actions">
      <HireButton class="selected-link" />
      <BookCallButton class="selected-link" />
    </div>
  </section>
</PageLayout>

<script>
  function init() {
    const stage = document.querySelector<HTMLElement>('#selected-media')
    if (!stage) {
      return
    }
    const imgs = [...stage.querySelectorAll<HTMLElement>('[data-selected-img]')]
    if (imgs.length < 2) {
      return
    }

    let idx = 0
    const tick = () => {
      imgs[idx]?.classList.remove('is-active')
      let next = idx
      while (next === idx) {
        next = Math.floor(Math.random() * imgs.length)
      }
      idx = next
      imgs[idx]?.classList.add('is-active')
    }
    window.setInterval(tick, 1000)
  }

  init()
</script>

<style>
  .selected {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    min-height: 100vh;
    box-sizing: border-box;
  }

  .selected-nav {
    display: flex;
    flex-direction: column;
  }

  .selected-link {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 55px;
    line-height: 1;
    letter-spacing: var(--letter-spacing-heading);
    font-feature-settings: 'ss03', 'ss02';
    color: var(--color-text-inverse);
    background: transparent;
    border: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
  }

  .selected-link:hover {
    color: var(--color-text);
  }

  .selected-link--lab {
    position: relative;
    align-self: flex-start;
  }

  .selected-star {
    position: absolute;
    left: 100%;
    top: 0;
    margin-left: 5px;
    margin-top: 5px;
    color: var(--color-text-secondary);
    animation: selected-star-spin 12s linear infinite;
  }

  @keyframes selected-star-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selected-star {
      animation: none;
    }
  }

  .selected-media-wrap {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    column-gap: var(--col-gap);
  }

  .selected-media {
    position: relative;
    grid-column: 1 / 3;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }

  .selected-media__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .selected-media__slide.is-active {
    opacity: 1;
  }

  .selected-media__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .selected-actions {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  .selected-actions :global(.selected-link) {
    font-size: var(--font-size-heading);
  }
</style>
