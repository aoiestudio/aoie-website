---
import { ClientRouter } from 'astro:transitions'
import '../styles/preflight.css'
import '../styles/media.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/typography.css'
import '../styles/layout.css'
import GridDebugger from '../components/GridDebugger.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      /* oxlint-disable */
      ;(function (C, A, L) {
        if (C.Cal && C.Cal.loaded) {
          return
        }
        let p = function (a, ar) {
          a.q.push(ar)
        }
        let d = C.document
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal
            let ar = arguments
            if (!cal.loaded) {
              cal.ns = {}
              cal.q = cal.q || []
              d.head.appendChild(d.createElement('script')).src = A
              cal.loaded = true
            }
            if (ar[0] === L) {
              /** @type {any} */
              const api = (...args) => p(api, args)
              const namespace = ar[1]
              api.q = api.q || []
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api
                p(cal.ns[namespace], ar)
                p(cal, ['initNamespace', namespace])
              } else {
                p(cal, ar)
              }
              return
            }
            p(cal, ar)
          }
      })(window, 'https://app.cal.com/embed/embed.js', 'init')
      Cal('init', 'studio', { origin: 'https://app.cal.com' })
      Cal.ns.studio('ui', {
        hideEventTypeDetails: false,
        layout: 'month_view',
      })
      /* oxlint-enable */
    </script>
    <script is:inline>
      // Apply saved works-grid positions before first paint to prevent FOUC
      ;(function () {
        try {
          const raw = localStorage.getItem('works-positions')
          if (!raw) {
            return
          }
          const data = JSON.parse(raw)
          if (
            !data ||
            data.width !== window.innerWidth ||
            !Array.isArray(data.positions)
          ) {
            return
          }
          const style = document.createElement('style')
          const rules = []
          const n = data.positions.length
          for (let i = 0; i < n; i++) {
            const pos = data.positions[i]
            if (typeof pos === 'number') {
              rules.push(
                '.wg-row:nth-child(' +
                  (i + 1) +
                  ') .wg-item{transform:translateX(' +
                  pos +
                  'px)}',
              )
            }
          }
          style.textContent = rules.join('')
          document.head.append(style)
          // oxlint-disable-next-line no-empty
        } catch {}
      })()
    </script>
  </head>
  <body>
    <slot />
    <GridDebugger />
  </body>
</html>
