---
import { Font } from 'astro:assets'
import '../styles/preflight.css'
import '../styles/media.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/typography.css'
import '../styles/layout.css'
import GridDebugger from '@/components/dev/GridDebugger.astro'
import CalComEmbed from '@/components/embeds/CalComEmbed.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
  noindex?: boolean
}

const { title, description, ogImage, noindex } = Astro.props
const canonicalUrl = Astro.url.href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- <meta name="color-scheme" content="light dark" /> -->
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aoie Studio" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://plausible.aoiestudio.ru" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      id="favicon-svg"
      href="/icon-light.svg"
      type="image/svg+xml"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      ;(function () {
        const el = document.querySelector('#favicon-svg')
        if (el && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          el.href = '/icon-dark.svg'
        }
      })()
    </script>
    <Font cssVariable="--font-geist" preload />
    <slot name="head" />
    <script>
      import { init } from '@plausible-analytics/tracker'
      init({
        domain: 'aoiestudio.ru',
        endpoint: 'https://plausible.aoiestudio.ru/api/event',
        outboundLinks: true,
      })
    </script>
    <CalComEmbed />
    <script is:inline>
      // Apply saved works-grid positions before first paint to prevent FOUC
      ;(function () {
        try {
          const raw = localStorage.getItem('works-positions')
          if (!raw) {
            return
          }
          const data = JSON.parse(raw)
          if (
            !data ||
            data.width !== window.innerWidth ||
            !Array.isArray(data.positions)
          ) {
            return
          }
          const style = document.createElement('style')
          const rules = []
          const n = data.positions.length
          for (let i = 0; i < n; i++) {
            const pos = data.positions[i]
            if (typeof pos === 'number') {
              rules.push(
                '.wg-row:nth-child(' +
                  (i + 1) +
                  ') .wg-item{transform:translateX(' +
                  pos +
                  'px)}',
              )
            }
          }
          style.textContent = rules.join('')
          document.head.append(style)
          // oxlint-disable-next-line no-empty
        } catch {}
      })()
    </script>
  </head>
  <body>
    <slot />
    <GridDebugger />
  </body>
</html>
