---
import { Picture } from 'astro:assets'

interface Props {
  left: string
  right: string
  altLeft?: string
  altRight?: string
}

const { left, right, altLeft = '', altRight = '' } = Astro.props
---

<div class="project-pair">
  <div class="project-pair__item">
    <Picture src={left} formats={['avif', 'webp']} width={800} alt={altLeft} />
  </div>
  <div class="project-pair__item">
    <Picture
      src={right}
      formats={['avif', 'webp']}
      width={800}
      alt={altRight}
    />
  </div>
</div>

<style>
  .project-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
    width: 100%;
  }

  .project-pair__item :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
