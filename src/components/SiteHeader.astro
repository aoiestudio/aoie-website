---
import HireButton from './HireButton.astro'
---

<header class="nav page-wrap section-grid">
  <a href="/" class="col-label nav-logo text-heading">aoie</a>
  <div class="col-content nav-right text-body">
    <nav class="nav-links" aria-label="Main">
      <a href="/">Studio</a>
      <a href="/work" aria-disabled="true" tabindex="-1" class="nav-link--disabled">Work</a>
      <a href="#connect" class="nav-link--connect">Connect</a>
    </nav>
    <HireButton class="nav-hire link" />
    <button type="button" class="nav-burger" aria-label="Open menu">
      <!-- 49×6 “pill dash” line ×3, 5px gap (node 44:2 euaaaio-design) -->
      <svg
        class="nav-burger__icon"
        width="49"
        height="28"
        viewBox="0 0 49 28"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        {
          [0, 11, 22].map((y) => (
            <g transform={`translate(0, ${y})`}>
              {Array.from({ length: 12 }, (_, index) => (
                <rect
                  x={1.5 + index * 4}
                  y="0"
                  width="2"
                  height="6"
                  rx="1"
                />
              ))}
            </g>
          ))
        }
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    align-items: start;
    padding-top: var(--2-lh);
    mix-blend-mode: difference;
  }

  .nav-logo {
    line-height: 1;
    margin-top: -6px;
  }

  .nav-right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--2-lh);
  }

  .nav-burger {
    display: none;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-burger:hover {
    opacity: 0.85;
  }

  .nav-burger:focus-visible {
    outline: 1px solid var(--color-gray-40);
    outline-offset: 4px;
  }

  .nav-burger__icon {
    display: block;
  }

  .nav-links {
    display: flex;
    gap: var(--2-lh);
  }

  .nav-link--disabled {
    pointer-events: none;
    color: var(--color-gray-40);
  }

  .nav-link--connect {
    color: var(--color-gray-50);
  }

  .nav-link--connect:hover {
    color: var(--color-white);
  }

  @media (--mobile) {
    .nav {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .nav-right {
      width: auto;
      flex: 0 0 auto;
      margin-left: auto;
      justify-content: flex-end;
    }

    .nav-links {
      display: none;
    }

    .nav-burger {
      display: inline-flex;
    }
  }

</style>
