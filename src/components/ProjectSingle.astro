---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt?: string
}

const { src, alt = '' } = Astro.props
---

<div class="project-single">
  <Picture src={src} formats={['avif', 'webp']} width={1600} alt={alt} />
</div>

<style>
  .project-single {
    width: 100%;
  }

  .project-single :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
