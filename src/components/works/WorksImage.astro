---
import { getCollection } from 'astro:content'
import BaseImage from '@/components/base/BaseImage.astro'

interface Props {
  filename: string
  priority?: boolean
  /** Override the project slug. Defaults to Astro.locals.project set by the works/[id] page. */
  project?: string
}

const {
  filename,
  priority = false,
  project = Astro.locals.project ?? '',
} = Astro.props

const projects = await getCollection('projects')
const projectData = projects.find(p => p.id === project)
const imageIndex = projectData?.data.images.indexOf(filename) ?? -1
const isHighPriority = priority || imageIndex < 2

const alt = projectData
  ? [
      projectData.data.title,
      `by aoie studio${projectData.data.year ? `, ${projectData.data.year}` : ''}.`,
      projectData.data.description,
    ]
      .filter(Boolean)
      .join(' ')
  : ''
---

<BaseImage
  class="project-single"
  src={`projects/${project}/images/${filename}`}
  layout="full-width"
  priority={isHighPriority}
  alt={alt}
/>

<style>
  :global(.project-single) {
    width: 100%;
  }
</style>
